# Copy to /etc/braxon-scan/env  (chmod 600, owned by braxon-scan)

# Postgres — the SAME database BRAXON's db_config.json points at
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=braxon
PGUSER=braxon
PGPASSWORD=change-me

# HTTP listener
SCAN_BIND=0.0.0.0
SCAN_PORT=8481

# TLS. Phones open the QR URL directly, so this serves HTTPS itself with a
# self-signed cert (the one-time browser warning is expected). Set to "off"
# only if you put it behind a reverse proxy that terminates TLS.
SCAN_TLS=on
SCAN_TLS_CERT=/etc/braxon-scan/cert.pem
SCAN_TLS_KEY=/etc/braxon-scan/key.pem
