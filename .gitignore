# Ignore everything under .claude except the shared, committed config:
# settings.json carries the project test-on-change hooks (see CLAUDE.md §3).
.claude/*
!.claude/settings.json

ecu

# Local DB credentials - the app reads %APPDATA%\pic-abs-tester\db_config.json
src-tauri/db_config.json

# Real customer/job data pulled from REMAN 4D for local investigation -
# never committed, this repo is public. Scoped to docs/ specifically so
# docs/reman-schema.md (prose, no raw exports) is unaffected.
docs/*.csv

# REMAN 4D's own proprietary method source, pasted here while reading it in
# Design mode during the BRAXON<->4D migration work - it's the ERP vendor's
# code, not ours, and never belongs in this public repo.
docs/4dreadings.txt

# Generated hydraulic bench reports saved locally while testing - name a
# real customer/job. The app's own save dialog is what puts these at the
# project root; nothing reads them back from here.
/*.pdf
